{
  "name": "hr-360-v2",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "build": "npm run build:backend && npm run build:admin && npm run build:h5",
    "build:backend": "npm --prefix backend run build",
    "build:admin": "npm --prefix admin run build",
    "build:h5": "npm --prefix h5 run build",
    "test:integration": "node scripts/integration-test.mjs",
    "typecheck": "npm run build:backend && npm --prefix admin exec -- vue-tsc -b admin/tsconfig.json && npm --prefix h5 exec -- vue-tsc -b h5/tsconfig.json"
  },
  "devDependencies": {
    "mysql2": "^3.22.5",
    "playwright": "^1.59.1"
  },
  "description": "HRsys 是一套企业内部绩效评价系统，当前主线版本为 `V2.1`。项目包含后端服务、PC 管理端和移动端 H5，支持批次管理、评价矩阵、题目模板、评价关系、移动端评分、进度监控、数据统计、Excel 导出，以及独立的实习生打卡模块。",
  "main": "start-admin-tunnel.js",
  "directories": {
    "doc": "docs"
  },
  "dependencies": {
    "aws-ssl-profiles": "^1.1.2",
    "denque": "^2.1.0",
    "generate-function": "^2.3.1",
    "iconv-lite": "^0.7.2",
    "is-property": "^1.0.2",
    "long": "^5.3.2",
    "lru.min": "^1.1.4",
    "named-placeholders": "^1.1.6",
    "playwright-core": "^1.59.1",
    "safer-buffer": "^2.1.2",
    "sql-escaper": "^1.3.3",
    "undici-types": "^8.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanker2006/HRsys.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/sanker2006/HRsys/issues"
  },
  "homepage": "https://github.com/sanker2006/HRsys#readme"
}
